{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/fi/",
      "permanent": false
    },
    {
      "source": "/capability",
      "destination": "/fi/capability/",
      "permanent": true
    },
    {
      "source": "/literacy",
      "destination": "/fi/literacy/",
      "permanent": true
    },
    {
      "source": "/transformation",
      "destination": "/fi/transformation/",
      "permanent": true
    },
    {
      "source": "/transformerism",
      "destination": "/fi/transformation/",
      "permanent": true
    },
    {
      "source": "/fi/transformerism",
      "destination": "/fi/transformation/",
      "permanent": true
    },
    {
      "source": "/en/transformerism",
      "destination": "/en/transformation/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/fi/tietosuoja/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/fi/ehdot/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/fi/yhteys/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}